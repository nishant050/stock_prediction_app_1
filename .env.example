# Example environment variables for local development
# Copy to .env and populate values before running locally

# Backend settings
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# GROQ API Key (used by frontend, set in localStorage or server side)
GROQ_API_KEY=

# If you deploy to a server, keep secrets in server-side environment variables and
# use the server-side proxy endpoint `/api/ai/chat` to perform AI calls rather than exposing keys in browser storage.
